{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Aquatic BitTorrent Tracker Dashboard",
  "title": "Aquatic Tracker Dashboard",
  "uid": "aquatic-tracker",
  "version": 1,
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["bittorrent", "tracker", "aquatic"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Active Torrents",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "aquatic_torrents_active",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Active Peers",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "aquatic_peers_active",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Announce Requests/s",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(aquatic_announce_requests_total[1m])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Scrape Requests/s",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(aquatic_scrape_requests_total[1m])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "rate(aquatic_announce_requests_total[1m])",
          "legendFormat": "Announce",
          "refId": "A"
        },
        {
          "expr": "rate(aquatic_scrape_requests_total[1m])",
          "legendFormat": "Scrape",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Active Peers Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "aquatic_peers_active",
          "legendFormat": "Total Peers",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Bandwidth Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "rate(aquatic_bandwidth_bytes_total[1m])",
          "legendFormat": "Bandwidth",
          "refId": "A"
        }
      ]
    }
  ]
}
