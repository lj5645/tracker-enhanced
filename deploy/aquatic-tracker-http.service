[Unit]
Description=Aquatic BT Tracker (HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tracker
ExecStart=/home/tracker/aquatic-linux-x86_64 http -c aquatic-config.toml
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=append:/home/tracker/aquatic-http.log
StandardError=append:/home/tracker/aquatic-http.log

[Install]
WantedBy=multi-user.target
